<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.studentattendance.controller.LoginController">
 <children>
  <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
   <children>
    <VBox alignment="CENTER" prefWidth="430.0" spacing="18.0" style="-fx-background-color: #17324D;">
     <padding><Insets bottom="40" left="45" right="45" top="40" /></padding>
     <children>
      <Label text="SAMS" textFill="WHITE">
       <font><Font name="System Bold" size="48.0" /></font>
      </Label>
      <Label alignment="CENTER" text="Student Attendance Management System" textFill="#D8E8F5" wrapText="true">
       <font><Font size="18.0" /></font>
      </Label>
      <Region VBox.vgrow="ALWAYS" />
      <Label alignment="CENTER" text="Manage students, courses and attendance&#10;from one place." textAlignment="CENTER" textFill="#D8E8F5" />
      <Region VBox.vgrow="ALWAYS" />
     </children>
    </VBox>
    <VBox alignment="CENTER" spacing="16.0" style="-fx-background-color: #F5F7FA;" HBox.hgrow="ALWAYS">
     <padding><Insets bottom="55" left="90" right="90" top="55" /></padding>
     <children>
      <Label text="Welcome Back" textFill="#17324D">
       <font><Font name="System Bold" size="30.0" /></font>
      </Label>
      <Label text="Sign in to continue" textFill="#667085" />
      <TextField fx:id="usernameField" maxWidth="360.0" prefHeight="44.0" promptText="Username" />
      <PasswordField fx:id="passwordField" maxWidth="360.0" prefHeight="44.0" promptText="Password" />
      <ComboBox fx:id="roleComboBox" maxWidth="360.0" prefHeight="44.0" promptText="Select Role" />
      <Button fx:id="loginButton" maxWidth="360.0" prefHeight="46.0" style="-fx-background-color: #17324D; -fx-text-fill: white; -fx-font-weight: bold;" text="LOGIN" />
      <Button fx:id="signUpButton" maxWidth="360.0" prefHeight="42.0" style="-fx-background-color: transparent; -fx-text-fill: #17324D; -fx-border-color: #17324D; -fx-border-radius: 5;" text="Create New Account" />
      <Label fx:id="errorLabel" textFill="#C62828" />
     </children>
    </VBox>
   </children>
  </HBox>
 </children>
</AnchorPane>